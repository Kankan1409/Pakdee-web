# ฐานข้อมูลหลัก (เก็บบัญชีผู้ใช้ทุกคน + ข้อมูลหอของบัญชีที่ไม่ได้ระบุฐาน)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ฐานข้อมูลเพิ่มเติม (Supabase project อื่น) — ไม่ใส่ = ใช้ฐานหลักฐานเดียวเหมือนเดิม
# สร้างฐานใหม่ด้วย docs/setup_new_database.sql แล้วผูกบัญชีด้วย docs/supabase_multi_database.sql
# NEXT_PUBLIC_EXTRA_DATABASES='[{"key":"db2","url":"https://xxxx.supabase.co","anonKey":"..."}]'
# SUPABASE_EXTRA_SERVICE_KEYS='{"db2":"<service_role key ของ db2>"}'
NEXT_PUBLIC_EXTRA_DATABASES=
SUPABASE_EXTRA_SERVICE_KEYS=

# LINE OA ตั้งในหน้า "ตั้งค่าหอพัก & LINE OA" ของแต่ละสาขา (ไม่ใช้ค่าใน .env แล้ว)
# ค่าด้านล่างใช้แค่ให้ scripts/dev-with-bot.mjs ตั้ง webhook ให้ OA นี้ (ถ้ามี)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Slip2Go API Key (สำหรับระบบตรวจสลิปโอนเงินอัตโนมัติกับธนาคารกลาง 24 ชม.)
# รับคีย์ได้จาก https://slip2go.com
SLIP2GO_SECRET_KEY=
# Copy API URL from your Slip2Go API Connect dashboard (HTTPS).
SLIP2GO_API_URL=
